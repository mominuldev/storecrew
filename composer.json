{
	"name": "decent-themes/storecrew",
	"description": "The AI employee platform for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"psr/container": "^2.0"
	},
	"require-dev": {
		"php-stubs/woocommerce-stubs": "^9.0",
		"phpstan/phpstan": "^2.0",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"StoreCrew\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"StoreCrew\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"invariants": "php tools/check-invariants.php",
		"test": "bash tests/integration/run.sh",
		"check": [
			"@lint",
			"@analyse",
			"@invariants",
			"@test"
		]
	},
	"extra": {
		"storecrew-api-version": "1.0"
	}
}
